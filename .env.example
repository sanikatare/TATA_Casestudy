# ==============================================================================
# AUTOSAR HLD Document Analysis Assistant - Environment Variables
# ==============================================================================

# Application & Server Configuration
APP_ENV=development
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=3000
VITE_BACKEND_URL=http://localhost:8000

# LLM Provider Configuration
# Set LLM_PROVIDER to 'gemini' or 'local_mock'
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Embeddings & Vector Store Configuration
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
CHROMA_COLLECTION_NAME=autosar_hld_chunks
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.60
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Storage & File Paths (Relative to project root)
DATA_DIR=./data
UPLOADS_DIR=./data/documents
PROCESSED_DIR=./data/processed
VECTOR_STORE_DIR=./vector_store/chroma
SQLITE_DB_PATH=./data/autosar_assistant.db
